# Postgres — usado tanto para migraciones como en runtime
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/control_operativo?schema=public"

# Firma de JWT — cambiar en produccion
JWT_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto del API
PORT=4000

# SMTP para el canal de email. Si se dejan vacios, el sistema usa un
# "console transport": las notificaciones se renderizan y quedan
# registradas en notifications/notification_logs, pero el "envio" solo
# se imprime en consola en vez de salir por SMTP real. Util para correr
# el MVP local sin credenciales de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Control Operativo <no-reply@control-operativo.local>"

# Intervalo (ms) con que el worker revisa notificaciones pendientes
WORKER_POLL_INTERVAL_MS=2000
